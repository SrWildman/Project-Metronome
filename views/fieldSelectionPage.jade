div(class="row panel vertical-center", id="field")
    div(class="container")
        div(class="row-md-1")
                h2(class="text-center") Field Selection 
        
        div(class="row-md-1")
            a(type="button", class="button btn btn-default", href="#main") Back
            button(type="button", class="button btn btn-default pull-right", data-toggle="modal", data-target="#myModalFS") ?
        
        div(class="row-md-1") 
            label(class="col-md-6 text-center")
                p High School
                input(type="radio", class="option-input radio", ng-model="fieldSelection", value="highschool")
            label(class="col-md-6 text-center")
                p College
                input(type="radio", class="option-input radio", ng-model="fieldSelection", value="college")
        
        div(class="row-md-1")
            a(type="button", class="button btn btn-default pull-right", href="#focal") Next


