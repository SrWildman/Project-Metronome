div(class="row panel vertical-center", id="focal")
    div(class="container")
        div(class="row-md-1")
            h2(class="text-center") Focal Point
        div(class="row-md-1")
            a(type="button", class="button btn btn-default", href="#field") Back 
            button(type="button", class="button btn btn-default pull-right", data-toggle="modal", data-target="#myModalFP") ?

        div(class="row-md-1") 
          label(class="col-md-4 text-center")
              p Drum Major Podium
              input(type="radio", class="option-input radio", ng-model="focalPoint", value="dmp")
          label(class="col-md-4 text-center")
              p High School Press Box
              input(type="radio", class="option-input radio", ng-model="focalPoint", value="hspb")
          label(class="col-md-4 text-center")
              p College Press Box
              input(type="radio", class="option-input radio", ng-model="focalPoint", value="cpb")
        div(class="row-md-1")
            a(type="button", class="button btn btn-default pull-right", href="#time") Next