extends layout

block content
  // includes
  link(rel="stylesheet", type="text/css", href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.6/css/bootstrap.min.css")
  script(type="text/javascript", src="https://code.jquery.com/jquery-1.11.3.js")
  script(type="text/javascript", src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.6/js/bootstrap.min.js")
  script(type="text/javascript", src="js/Highmaps/api/js/jquery-1.11.3.min.js")
  script(type="text/javascript", src="js/Highmaps/js/highcharts.js")
  script(type="text/javascript", src="js/Highmaps/js/modules/heatmap.js")
  script(type="text/javascript", src="js/metronome.module.js")
  script(type="text/javascript", src="js/backend.factory.js")
  script(type="text/javascript", src="js/dataHandler.factory.js")
  script(type="text/javascript", src="js/ctrl.controller.js")
  script(type="text/javascript", src="js/trim.filter.js")
  script(type="text/javascript", src="js/smoothScrolling.js")

  // app
  div(ng-app="metronome", class="container-fluid", ng-controller="tController")
    include ./tutorialPage.jade
    include ./mainPage.jade
    include ./fieldSelectionPage.jade
    include ./focalPointPage.jade
    include ./timeSourcePage.jade
    include ./resultsPage.jade
    include ./extrasPage.jade

