extends layout

block content
  // includes
  link(rel="stylesheet", type="text/css", href="https://cdn.jsdelivr.net/npm/bootstrap@3.4.1/dist/css/bootstrap.min.css")
  script(type="text/javascript", src="https://code.jquery.com/jquery-3.7.1.min.js")
  script(type="text/javascript", src="https://cdn.jsdelivr.net/npm/bootstrap@3.4.1/dist/js/bootstrap.min.js")
  script(type="text/javascript", src="js/Highmaps/js/highcharts.js")
  script(type="text/javascript", src="js/Highmaps/js/modules/heatmap.js")
  script(type="text/javascript", src="js/metronome.module.js")
  script(type="text/javascript", src="js/backend.factory.js")
  script(type="text/javascript", src="js/dataHandler.factory.js")
  script(type="text/javascript", src="js/ctrl.controller.js")
  script(type="text/javascript", src="js/trim.filter.js")
  script(type="text/javascript", src="js/smoothScrolling.js")

  // app
  div(ng-app="metronome", class="container-fluid", ng-controller="tController")
    include ./tutorialPage.pug
    include ./mainPage.pug
    include ./fieldSelectionPage.pug
    include ./focalPointPage.pug
    include ./timeSourcePage.pug
    include ./resultsPage.pug
    include ./extrasPage.pug

