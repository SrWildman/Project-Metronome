div(id="myModalFS", class="modal fade", role="dialog")
    div(class="modal-dialog")
        div(class="modal-content")
            div(class="modal-header")
                modalText HELP
                button(type="button", class="close", data-dismiss="modal") &times
            div(class="modal-body")
                modalText Select the hashes that are being used on your field.
                br 
                br
                button(type="button", class="btn btn-default", data-dismiss="modal") Close
                
div(id="myModalFP", class="modal fade", role="dialog")
    div(class="modal-dialog")
        div(class="modal-content")
            div(class="modal-header")
                modalText HELP
                button(type="button", class="close", data-dismiss="modal") &times
            div(class="modal-body")
                modalText Select a focal point. This is the point the ensemble is aiming to have their sound reach.
                br 
                br
                button(type="button", class="btn btn-default", data-dismiss="modal") Close

div(id="myModalTS", class="modal fade", role="dialog")
    div(class="modal-dialog")
        div(class="modal-content")
            div(class="modal-header")
                modalText HELP
                button(type="button", class="close", data-dismiss="modal") &times
            div(class="modal-body")
                modalText Enter the location of the time source. This is the location of the metronome, drumline, or anything else that is controlling tempo. Steps are a standard 22.5 inches. 
                br 
                br
                button(type="button", class="btn btn-default", data-dismiss="modal") Close
                
div(id="myModalR", class="modal fade", role="dialog")
    div(class="modal-dialog")
        div(class="modal-content")
            div(class="modal-header")
                modalText HELP
                button(type="button", class="close", data-dismiss="modal") &times
            div(class="modal-body")
                modalText The map consists of a grid marked in half-step increments. Detailed information about the individual locations on the field can be displayed by hovering over the map with the mouse. 
                modalText The Green section indicates the region where members can play with what they hear from the time source. 
                br
                br
                modalText If the drum major and time source (yellow dot) are visually together, anyone within the same ring as the time source may play with what they see from the drum major. 
                br
                br
                modalText For each member in each ring outside the time source must be one note ahead of what they see from the drum major.
                br
                br
                modalText For each member in each ring inside the time source, a member in that ring must be one note behind what they see from the drum major.
                br 
                br
                modalText The note value for error as well as the tempo can be selected in the extras menu.
                br 
                br
                button(type="button", class="btn btn-default", data-dismiss="modal") Close