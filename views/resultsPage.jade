div(class="row panel vertical-center", id="results")
    div(class="container", style="position: relative;")
        div(class="row-md-1")
            h1(class="text-center") PROJECT METRONOME

        div(class="row-md-1", id ="fieldWrap")
            img(src="stylesheets/backgrounds/CollegeField.jpg", ng-show="fieldSelection == 'college'")
            img(src="stylesheets/backgrounds/HighSchoolField.jpg", ng-show="fieldSelection == 'highschool'")
            div(class="row-md-1" id="fieldContainer")


        div(class="row-md-1 col-md-12")
            a(type="button", class="button btn btn-default pull-left", href="#main") Start Over
            a(type="button", class="button btn btn-default pull-right", href="#extras") Extras
        
        div(class="row-md-1 col-md-2 col-md-offset-4")
            button(type="button", class="button btn btn-default pull-right", data-toggle="modal", data-target="#myModalR") ?            
