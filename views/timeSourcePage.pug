div(class="row panel vertical-center", id="time")
    div(class="container")
        div(class="row-md-1")
            h2(class="text-center") Time Source        
        
        div(class="row-md-1")
            a(type="button", class="button btn btn-default", href="#focal") Back
            button(type="button", class="button btn btn-default pull-right", data-toggle="modal", data-target="#myModalTS") ?

        
        div(class="row-md-1")
            //- h4(class="text-center") {{ horWhoStp }}{{ horParStp }}
            div(class="col-md-6") 
                h4(class="text-center") Horizontal Whole Step : {{ horWhoStp }}
                input(type="range", min="0", max="4", step="1", ng-model="horWhoStp")
            div(class="col-md-6")
                h4(class="text-center") Horizontal Partial Step : {{ horParStp }}
                input(type="range", min="0", max="0.5", step="0.5", ng-model="horParStp")
        
        div(class="row-md-1 col-md-4 col-md-offset-4")
            label(class="col-md-6 text-center")
                p Inside
                input(type="radio", class="option-input radio", ng-model="horStpDir", value="inside")
            label(class="col-md-6 text-center")
                p Outside
                input(type="radio", class="option-input radio", ng-model="horStpDir", value="outside")


        div(class="row-md-1") 
            div(class="col-md-12")
               h4(class="text-center") {{ yardLine }} Yard Line   
               input(type="range", min="0", max="50", step="5", ng-model="yardLine")
            
        div(class="row-md-1 col-md-4 col-md-offset-4") 
            label(class="col-md-6 text-center")
                p Side 1
                input(type="radio", class="option-input radio", ng-model="fieldSide", value="1")
            label(class="col-md-6 text-center")
                p Side 2
                input(type="radio", class="option-input radio", ng-model="fieldSide", value="2")

        div(class="row-md-1")
            div(class="col-md-6 text-center")
                h4 Vertical Whole Step : {{ verWhoStp }}
                input(type="range", min="0", max="{{maxVerticalSteps[fieldSelection]}}", step="1", ng-model="verWhoStp")
            div(class="col-md-6 text-center")
                h4 Vertical Partial Step : {{ verParStp }}
                input(type="range", min="0", max="0.5", step="0.5", ng-model="verParStp")

        div(class="row-md-1  col-md-4 col-md-offset-4")
            label(class="col-md-6 text-center")
                p In Front Of
                input(type="radio", class="option-input radio", ng-model="verStpDir", value="front")
            label(class="col-md-6 text-center")
                p Behind
                input(type="radio", class="option-input radio", ng-model="verStpDir", value="back")

        div(class="row-md-1 col-md-12")
            label(class="col-md-3 text-center")
                p Front Sideline
                input(type="radio", class="option-input radio", ng-model="fieldMarker", value="fsl")
            label(class="col-md-3 text-center")
                p Front Hash
                input(type="radio", class="option-input radio", ng-model="fieldMarker", value="fh")
            label(class="col-md-3 text-center")
                p Back Hash
                input(type="radio", class="option-input radio", ng-model="fieldMarker", value="bh")
            label(class="col-md-3 text-center")
                p Back Sideline
                input(type="radio", class="option-input radio", ng-model="fieldMarker", value="bsl")
        
        div(class="row-md-1")
            a(type="button", class="button btn btn-default pull-right", href="#results" ng-click="res()") Finish
            
            

